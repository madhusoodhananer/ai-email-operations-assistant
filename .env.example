# Copy this file to .env and fill in the values.
# .env is git-ignored. Never commit real credentials.

# --- Database -----------------------------------------------------------
POSTGRES_DB=email_operations
POSTGRES_USER=email_operations
POSTGRES_PASSWORD=change_me

# Connection string used by the API service.
DATABASE_URL=postgresql://email_operations:change_me@localhost:5432/email_operations

# --- n8n ----------------------------------------------------------------
# Losing this key makes stored n8n credentials unrecoverable.
N8N_ENCRYPTION_KEY=change_me
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# --- LLM provider -------------------------------------------------------
OPENAI_API_KEY=

# Pin an explicit model version. Never use a floating alias — see ADR-002.
OPENAI_CLASSIFICATION_MODEL=
OPENAI_DRAFT_MODEL=

# --- Mailbox ------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Operations ---------------------------------------------------------
ADMIN_NOTIFICATION_EMAIL=

# Analyses below this confidence are routed to manual review.
# The value in force is recorded on each analysis row.
CONFIDENCE_THRESHOLD=0.75
